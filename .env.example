# Fireside's environment, operator-facing.
#
# Copy to .env or set them as container env / secrets. Nothing here ships with a
# working value and no key belongs in the repo. The list is exactly the names the
# code reads (grep `os.environ`), not a wish list; docs/PRICING.md,
# docs/PADDLE.md, docs/STORAGE.md and docs/PROVIDER-CONTRACT.md say what each
# group does.

# ---- data ----------------------------------------------------------------
# sqlite (default) or mysql
FIRESIDE_DB_TYPE=sqlite
# sqlite: a file path, or sqlite:///path. mysql: user:pass@host:3306/dbname
FIRESIDE_DB_CONN=
# the legacy single variable; sets engine and connection when the two above are unset
FIRESIDE_DB=
# require TLS on the mysql connection
FIRESIDE_DB_SSL=0
# where the sqlite file and local blobs live
FIRESIDE_DATA=./data

# ---- storage -------------------------------------------------------------
# local (default), or a storage plugin id
FIRESIDE_STORAGE=local
# the azure blob backend, when it is the one selected
FIRESIDE_AZURE_STORAGE_CONN=
FIRESIDE_AZURE_ACCOUNT=
FIRESIDE_AZURE_CONTAINER=
FIRESIDE_AZURE_ENDPOINT=
FIRESIDE_AZURE_KEY=
FIRESIDE_AZURE_SAS=

# ---- the server ----------------------------------------------------------
FIRESIDE_BASE_URL=http://127.0.0.1:8080
FIRESIDE_HOST_PORT=8080
# a hosted deployment is one that is not the reader's own machine
FIRESIDE_HOSTED=0
# a signed-in session is required for everything that is not a public page
FIRESIDE_REQUIRE_AUTH=0
# a second factor is required for accounts that have enrolled one
FIRESIDE_REQUIRE_2FA=0
# allow local username/password accounts (off means OAuth only)
FIRESIDE_ALLOW_LOCAL=1
FIRESIDE_OPEN=0
FIRESIDE_PLUGINS_ROOT=
FIRESIDE_UI_BROWSER=
FIRESIDE_COMPANY=Magic Smoke Technologies LLC
FIRESIDE_CONTACT_EMAIL=support@readfireside.com
FIRESIDE_BUILD=

# ---- sign-in -------------------------------------------------------------
FIRESIDE_OAUTH_SIMPLELOGIN_CLIENT_ID=
FIRESIDE_OAUTH_SIMPLELOGIN_SECRET=
FIRESIDE_OAUTH_X_CLIENT_ID=
FIRESIDE_OAUTH_X_SECRET=
FIRESIDE_OAUTH_FAKE_ID=
FIRESIDE_OAUTH_FAKE_CLIENT_ID=
FIRESIDE_OAUTH_FAKE_SECRET=

# ---- speech and the reader plugins --------------------------------------
# JSON or provider:voice[:model]; the one connection allowed to sell characters
FIRESIDE_SALE_CONNECTION=
FIRESIDE_AZURE_KEY=
FIRESIDE_SYNTH_ATTEMPTS=3
FIRESIDE_SYNTH_BACKOFF=1.5

# ---- payments ------------------------------------------------------------
# The module the host imports. Absent = no provider, and every purchase route
# refuses with "payments not configured" instead of failing somewhere odd.
FIRESIDE_PAYMENT_PROVIDER=host.payments_paddle
# Stripe, while it is still the configured processor on a deployment
FIRESIDE_STRIPE_KEY=
FIRESIDE_STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_PAYMENT_METHOD=

# Paddle. The sandbox key is pdl_sdbx_apikey_..., live is pdl_live_apikey_...
FIRESIDE_PADDLE_API_KEY=
# the notification destination's SECRET KEY (pdl_ntfset_...). This is NOT the
# API key; it is shown once, when the destination is created.
FIRESIDE_PADDLE_WEBHOOK_SECRET=
# sandbox | production; inferred from the key prefix when unset
FIRESIDE_PADDLE_ENV=sandbox
# optional JSON {price_id: plan}; defaults to the sandbox catalog
FIRESIDE_PADDLE_PRICES=
# seconds; 5 matches the Paddle SDKs. 0 disables the replay window.
FIRESIDE_PADDLE_SIGNATURE_TOLERANCE=5

# ---- mail ----------------------------------------------------------------
FIRESIDE_MAIL_FROM=support@readfireside.com
FIRESIDE_RESEND_API_KEY=
